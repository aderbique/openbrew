# Local-only configuration for scripts/run-dev.sh. Copy to .openbrew.dev.env
# and fill in real values. Do not commit the copied file.
#
# OPENBREW_SA_PASSWORD is required. SMTP and Google values are optional, but
# the related features remain unavailable until they are configured.
OPENBREW_SA_PASSWORD=replace-with-a-local-sql-password
GOOGLE_APPLICATION_KEY=replace-with-google-oauth-client-id
GOOGLE_APPLICATION_SECRET=replace-with-google-oauth-client-secret
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
