@model SetPasswordViewModel

@{
	ViewBag.Title = "Set Password";
}

<div id="view-setpassword" class="content">
    <h3>Set a new password</h3>
    <p>Choose a new password below. Keep it reasonably strong so future-you has fewer regrets.</p>

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.AuthToken)

        <div class="form-field">
            @Html.LabelFor(m => m.Password, "New password")
            <span>@Html.TextBoxFor(m => m.Password, new { type = "password" })</span>
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.ConfirmPassword, "Confirm password")
            <span>@Html.TextBoxFor(m => m.ConfirmPassword, new { type = "password" })</span>
        </div>

        <input type="submit" value="Set Password" class="button button_green" />
    }
</div>
