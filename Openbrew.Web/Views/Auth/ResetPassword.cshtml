@model PasswordResetViewModel

@{
	ViewBag.Title = "Reset Password";
}

<div id="view-resetpassword" class="content">
    <h3>Reset your password</h3>
    <p>Enter the email address tied to your account and we will send a reset link.</p>

    @using (Html.BeginForm())
    {
        <div class="form-field">
            @Html.LabelFor(m => m.EmailAddress, "Email address")
            <span>@Html.TextBoxFor(m => m.EmailAddress, new { type = "email" })</span>
        </div>

        <input type="submit" value="Send Reset Link" class="button button_green" />
    }
</div>
