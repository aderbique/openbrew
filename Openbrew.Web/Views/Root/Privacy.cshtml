@{
	ViewBag.Title = "Privacy";
}

<div id="privacy-view" class="content">
    <h3>Privacy policy</h3>
    <p>
        OpenBrew keeps the usual old-school promise: use the minimum data needed to run the app, do not pretend stale
        infrastructure is magic, and do not sell user data.
    </p>
    <ul>
        <li>Recipe and account data are used to run the site</li>
        <li>Email is used for account and recipe notifications</li>
        <li>We do not share user data without a real reason</li>
    </ul>
</div>
