@{
	ViewBag.Title = "About OpenBrew";
	ViewBag.Description = "OpenBrew is the modern continuation of the Brewgr homebrew recipe platform.";
}

<div id="view-about" class="content">
    <div class="two_third floatleft">
        <h3>Built for homebrewers</h3>
        <p>
            OpenBrew helps homebrewers create recipes, clone public ideas, compare calculations, and keep brew-day notes in one place.
        </p>

        <h4>Core jobs</h4>
        <ul>
            <li>Build all-grain and extract recipes with live calculations</li>
            <li>Clone, print, and export recipes as BeerXML</li>
            <li>Track brew sessions and tasting notes</li>
            <li>Browse styles, ingredients, and community recipes</li>
        </ul>

        <h4>Modernized for 2026</h4>
        <p>
            The app is being tuned to keep the useful legacy workflows working while replacing brittle page shells and stale
            presentation layers with a cleaner system.
        </p>

        <p class="fine-print">
            Source: <a href="https://github.com/aderbique/openbrew">github.com/aderbique/openbrew</a><br />
            Original source: <a href="https://github.com/rak-phillip/Brewgr.com">github.com/rak-phillip/Brewgr.com</a>
        </p>
        <p class="fine-print">
            OpenBrew is a modernized fork of an older open-source homebrew app. It is not affiliated with Brewgr.com or BrewersFriend.
        </p>
    </div>
</div>
