@{
	ViewBag.Title = "How It Works";
	ViewBag.Description = "OpenBrew lets you build a recipe, share it, brew it, and track what happened next.";
}

<div id="howitworks" class="content">
    <div class="two_third floatleft">
        <h2 class="howitworks-header">Simple workflow, serious brewing</h2>
        <h3>1. Build a recipe</h3>
        <p>Add fermentables, hops, yeast, adjuncts, and mash steps in the recipe builder.</p>

        <h3>2. Share and clone</h3>
        <p>Share a public recipe link, clone it, export it as BeerXML, or print it for brew day.</p>

        <h3>3. Brew and track</h3>
        <p>Log brew sessions and tasting notes so the recipe history stays useful after brew day.</p>
    </div>
</div>
