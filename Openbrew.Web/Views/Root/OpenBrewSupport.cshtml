@{
    Layout = "~/Views/Shared/_OpenBrewLayout.cshtml";
    ViewBag.Title = "Support OpenBrew";
    ViewBag.Description = "Help keep OpenBrew free for every homebrewer.";
}

<div id="view-support" class="support-page">
    <section class="support-intro">
        <p class="eyebrow">Keep the kettle on</p>
        <h1>OpenBrew is free. Always.</h1>
        <p class="support-lede">Creating recipes, saving your brew notes, and using the tools will never come with a subscription or a surprise charge.</p>
    </section>

    <section class="support-panel">
        <div class="support-copy">
            <h2>Made for brewers, funded by brewers.</h2>
            <p>OpenBrew is an independent, open-source service. Donations help cover the ordinary costs of keeping it online: hosting, maintenance, and the occasional late-night fix before brew day.</p>
            <p>Contributing is completely optional. If OpenBrew has helped with a batch, a recipe, or a new idea, a coffee is a meaningful way to help keep it available to everyone.</p>
        </div>
        <aside class="support-action" aria-label="Donate to OpenBrew">
            <span class="support-cup" aria-hidden="true">&#9749;</span>
            <h2>Buy OpenBrew a coffee</h2>
            <p>One-time support, no account required.</p>
            <a class="button button_green bold" href="https://buymeacoffee.com/aderbique" target="_blank" rel="noopener noreferrer">Support on Buy Me a Coffee</a>
        </aside>
    </section>

    <p class="support-note">Thank you for helping make good brewing tools accessible to every homebrewer.</p>
</div>
