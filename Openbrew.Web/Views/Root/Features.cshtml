@{
	ViewBag.Title = "Features";
	ViewBag.Description = "OpenBrew features a live homebrew recipe builder, clone and share workflows, BeerXML export, brew sessions, and recipe browsing.";
}

<div id="view-features" class="content">
    <div class="two_third floatleft">
        <h3>What OpenBrew does</h3>
        <p>
            OpenBrew is a recipe-first homebrew app. You can build recipes, clone public recipes, share links, print or export BeerXML,
            and keep track of brew sessions and tasting notes.
        </p>
        <p class="fine-print">
            Want the original Brewgr features page for comparison?
            <a href="https://web.archive.org/web/20190222104828/http://brewgr.com/features" target="_blank" rel="noopener noreferrer">View the archived 2019 version</a>.
        </p>

        <h4>Highlights</h4>
        <ul>
            <li>Live recipe calculator with editable ingredients and steps</li>
            <li>Public recipe pages with share, clone, print, and export actions</li>
            <li>Style browsing and ingredient detail pages</li>
            <li>Dashboard and profile views for your own work</li>
        </ul>
    </div>
</div>
