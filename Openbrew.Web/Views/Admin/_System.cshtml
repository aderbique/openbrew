@using System
@using System.Collections
@using System.Reflection
@using Openbrew.Web
@using Openbrew.Web.Core.Model

@{
	var releaseVersion = System.Environment.GetEnvironmentVariable("OPENBREW_RELEASE_VERSION");
	var environmentName = System.Environment.GetEnvironmentVariable("Environment") ?? "local";
	var assemblyVersion = typeof(Openbrew.Web.Controllers.AdminController).Assembly.GetName().Version;
	var cacheKeys = Context.Cache.Cast<DictionaryEntry>()
		.Where(x => !x.Key.ToString().StartsWith("__"))
		.Where(x => !x.Key.ToString().StartsWith(":ViewCacheEntry"));
}

<section class="admin-runtime-panel" aria-label="OpenBrew runtime information">
    <div>
        <span>OpenBrew version</span>
        <strong>@(string.IsNullOrWhiteSpace(releaseVersion) ? "Local source build" : releaseVersion)</strong>
    </div>
    <div>
        <span>Application build</span>
        <strong>@assemblyVersion</strong>
    </div>
    <div>
        <span>Environment</span>
        <strong>@environmentName</strong>
    </div>
</section>

<h3>Cached Objects</h3>

@if(cacheKeys.Any())
{
    <ul class="list" id="cache-items">
        @foreach (DictionaryEntry item in cacheKeys)
        {
            <li><a href="#" data-key="@item.Key">[remove</a>] - @item.Key</li>
        }
    </ul>
}
else
{
	<div>There are currently no items in the Cache</div>
}
